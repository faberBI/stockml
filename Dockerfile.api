FROM python:3.12-slim
WORKDIR /srv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 STOCKML_ROOT=/srv PORT=8000
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[api]"
# il modello allenato dal workflow settimanale viene "cotto" nell'immagine
COPY artifacts ./artifacts
EXPOSE 8000
CMD ["sh", "-c", "uvicorn stockml.api.main:app --host 0.0.0.0 --port ${PORT}"]
